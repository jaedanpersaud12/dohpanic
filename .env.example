# ---------------------------------------------------------------- database
# Neon Postgres. Use the pooled connection string ("-pooler" in the host).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------- Clerk
# Staff/door logins. Buyers never sign in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ---------------------------------------------------------- Cloudflare R2
# Private bucket for payment screenshots. Never make it public.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=dohpanic-screenshots

# ------------------------------------------------------- ticket signing
# Long random string. Rotating it invalidates every QR already issued.
TICKET_SECRET=change-me-to-a-long-random-string

# ------------------------------------------------------------- public URL
# Baked into every QR code. Set it before issuing any tickets.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------ staff access
# Being signed in is NOT enough — Clerk sign-up is public by default.
# Only these addresses can reach /admin. Comma-separated.
STAFF_EMAILS=you@example.com,doorperson@example.com

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
